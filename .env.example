# BuildLedger environment template
# Copy this file to .env.local for local development. Never commit .env.local.

# -----------------------------------------------------------------------------
# Public browser-safe configuration (local, preview, and production)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# -----------------------------------------------------------------------------
# Server-only application configuration
# APP_ENV must be development, preview, test, or production.
# Production startup validates every mandatory production value without logging it.
# -----------------------------------------------------------------------------
APP_ENV=development
OWNER_EMAIL_ALLOWLIST=owner@example.com
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SUPABASE_SERVICE_ROLE_KEY
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# Google OAuth and Drive (server-only)
GOOGLE_OAUTH_CLIENT_ID=YOUR_GOOGLE_OAUTH_CLIENT_ID
GOOGLE_OAUTH_CLIENT_SECRET=YOUR_GOOGLE_OAUTH_CLIENT_SECRET
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:3000/api/integrations/google-drive/callback
GOOGLE_TOKEN_ENCRYPTION_KEY=BASE64_ENCODED_32_BYTE_KEY
GOOGLE_DRIVE_ROOT_FOLDER_ID=OPTIONAL_AFTER_FIRST_CONNECTION
GOOGLE_DRIVE_BACKUP_FOLDER_ID=OPTIONAL_AFTER_FOLDER_SETUP

# Project defaults (keep unset until the owner chooses production values)
DEFAULT_CURRENCY=
PROJECT_TIMEZONE=
TAX_ENABLED=false
DEFAULT_TAX_METHOD=exclusive
WAGE_RATE_METHODS=hourly,daily

# Future AI integration. Leave disabled and unset for the first release.
AI_FEATURES_ENABLED=false
AI_PROVIDER=
AI_API_KEY=

# -----------------------------------------------------------------------------
# GitHub Actions-only values (set as repository Actions secrets/variables,
# not in Vercel and not in local browser configuration)
# -----------------------------------------------------------------------------
BACKUP_DATABASE_URL=postgresql://USER:PASSWORD@SESSION_POOLER_HOST:5432/postgres
BACKUP_ENCRYPTION_RECIPIENT=age1PUBLIC_RECIPIENT
GOOGLE_DRIVE_BACKUP_REFRESH_TOKEN=SERVER_ONLY_REFRESH_TOKEN
GOOGLE_DRIVE_BACKUP_FOLDER_ID=DRIVE_FOLDER_ID
